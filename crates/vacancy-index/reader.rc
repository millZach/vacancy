#pragma code_page(65001)
#include <winver.h>

1 24 VACANCY_MANIFEST

VS_VERSION_INFO VERSIONINFO
FILEVERSION VACANCY_VERSION_NUM
PRODUCTVERSION VACANCY_VERSION_NUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Zach Miller"
            VALUE "FileDescription", "Vacancy scan helper"
            VALUE "FileVersion", VACANCY_VERSION_STR
            VALUE "InternalName", "vacancy-index-reader"
            VALUE "OriginalFilename", "vacancy-index-reader.exe"
            VALUE "ProductName", "Vacancy"
            VALUE "ProductVersion", VACANCY_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
